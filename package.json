{
  "name": "brasswake",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5230 --strictPort",
    "build": "tsc --noEmit && vite build",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "check": "npm run format:check && npm run test && npm run build && npm run test:browser",
    "format:check": "prettier --check src tests *.ts *.json index.html"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.0",
    "@types/node": "^24.0.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
